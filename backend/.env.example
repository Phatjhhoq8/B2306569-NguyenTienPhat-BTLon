# Cấu hình môi trường chạy ứng dụng (development, production, test)
NODE_ENV=development
PORT=3000

# Kết nối cơ sở dữ liệu MongoDB
MONGODB_URI=mongodb://localhost:27017/book_borrowing

# Cấu hình bảo mật JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Cấu hình nghiệp vụ mặc định
DEFAULT_SHELF_LOCATION=KE-A1
DEFAULT_BOOK_COPIES_COUNT=3
